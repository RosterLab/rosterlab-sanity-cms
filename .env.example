# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token
SANITY_PREVIEW_SECRET=your-strong-preview-secret

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Intercom
NEXT_PUBLIC_INTERCOM_APP_ID=your-intercom-app-id1

# Datadog
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your-datadog-client-token
NEXT_PUBLIC_DATADOG_APPLICATION_ID=your-datadog-app-id
NEXT_PUBLIC_DATADOG_SERVICE=your-service-name`
NEXT_PUBLIC_DATADOG_ENV=production

# Statsig (A/B Testing & Session Replay)
NEXT_PUBLIC_STATSIG_CLIENT_KEY=client-your-statsig-client-key
STATSIG_SERVER_SECRET=secret-your-statsig-server-secret

# Roster Analysis API
NEXT_PUBLIC_ANALYZE_API_URL=https://analyze-api.rosterlab.com

# Microsoft Teams Notifications (Optional)
# Get webhook URL from: Teams Channel → 3 dots → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# Attio CRM
# URL from an Attio "Webhook received" workflow. Keep server-side.
ATTIO_LEAD_WEBHOOK_URL=https://app.attio.com/webhook/your-workflow-webhook

# Market access
# Standard demo availability (for example, 9am–5pm Pacific/Auckland)
NEXT_PUBLIC_CALENDLY_STANDARD_URL=https://calendly.com/your-team/standard-demo
# Extended US demo availability
NEXT_PUBLIC_CALENDLY_US_24_7_URL=https://calendly.com/your-team/us-extended-demo
# Emergency kill switch: true restores signup and standard demo access globally
MARKET_ACCESS_GATING_DISABLED=false
# Optional production QA override; leave false in normal production operation
MARKET_ACCESS_ALLOW_TEST_COUNTRY=false

# Google Analytics 4 (loaded directly in code; unset to disable, e.g. previews)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
